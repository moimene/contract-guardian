{
  "name": "UTIL_GenerateEmbeddings",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, example_text FROM policy_examples WHERE embedding IS NULL ORDER BY created_at LIMIT {{ $json.batch_size || 50 }}",
        "options": {}
      },
      "id": "get_pending",
      "name": "Get Pending Examples",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        460,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "YOUR_POSTGRES_CREDENTIAL_ID",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.id }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "check_results",
      "name": "Has Results?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "batchSize": 10,
        "options": {}
      },
      "id": "batch_items",
      "name": "Batch Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        900,
        200
      ]
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "createEmbedding",
        "model": "text-embedding-3-small",
        "text": "={{ $json.example_text }}",
        "options": {
          "dimensions": 1536
        }
      },
      "id": "openai_embedding",
      "name": "Generate Embedding",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1,
      "position": [
        1120,
        200
      ],
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAI"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE policy_examples SET embedding = '{{ JSON.stringify($json.embedding) }}'::vector WHERE id = '{{ $('batch_items').item.json.id }}'",
        "options": {}
      },
      "id": "update_embedding",
      "name": "Update Embedding",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1340,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "YOUR_POSTGRES_CREDENTIAL_ID",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "values": {
          "number": [
            {
              "name": "processed",
              "value": "={{ $items().length }}"
            }
          ],
          "string": [
            {
              "name": "status",
              "value": "Batch completed"
            }
          ]
        },
        "options": {}
      },
      "id": "batch_result",
      "name": "Batch Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1560,
        200
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "All embeddings generated"
            }
          ]
        },
        "options": {}
      },
      "id": "done",
      "name": "All Done",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        900,
        400
      ]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Get Pending Examples",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Pending Examples": {
      "main": [
        [
          {
            "node": "Has Results?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Results?": {
      "main": [
        [
          {
            "node": "Batch Items",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "All Done",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Batch Items": {
      "main": [
        [
          {
            "node": "Generate Embedding",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Embedding": {
      "main": [
        [
          {
            "node": "Update Embedding",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update Embedding": {
      "main": [
        [
          {
            "node": "Batch Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Batch Result": {
      "main": [
        [
          {
            "node": "Batch Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "meta": {
    "instanceId": "amazon-redliner"
  },
  "tags": [
    {
      "name": "utility"
    },
    {
      "name": "embeddings"
    }
  ]
}