            "id": "ai_parse",
            "name": "AI Parse Clauses",
            "position": [
                1200,
                304
            ],
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "credentials": {
                "openAiApi": {
