      "parameters": {
        "jsCode": "// Workflow Configuration for Nueva Planta\nconst config = {\n  SUPABASE_URL: 'https://hvlsuwdqtfiilvampxq.supabase.co',\n  N8N_WEBHOOK_BASE: 'https://mmenendeza.app.n8n.cloud',\n  PLAYBOOK_ID: 'nueva_planta',\n  PLAYBOOK_VERSION: '2026-01',\n  CLAUSE_REVIEW_ENDPOINT: '/webhook/clause-review-nueva-planta',\n  CLAUSE_TIMEOUT: 120000,\n  // Familias de Nueva Planta\n  CLAUSE_FAMILIES: [\n    'PrecioPagos',\n    'AlcanceTrabajo', \n    'Responsabilidades',\n    'EntregablesHitos',\n    'TerminacionRescision'\n  ]\n};\n\nreturn [{ json: { config } }];"
      },
