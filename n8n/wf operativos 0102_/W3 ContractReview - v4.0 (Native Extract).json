        {
            "parameters": {
                "jsCode": "// Build signed URL for Supabase Storage download\nconst doc = $json[0] || $json;\nconst storagePath = doc.storage_path;\nconst fileName = doc.file_name || 'document';\nconst precalc = $('Pre-calc Params').first().json;\n\nif (!storagePath) {\n  throw new Error('Document storage_path is null - cannot download file');\n}\n\n// storage_path format: \"contracts/timestamp_filename.docx\"\n// For Supabase Storage: bucket/path within bucket\nconst pathWithinBucket = storagePath.replace(/^contracts\\//, '');\n\nconst ext = fileName.split('.').pop()?.toLowerCase() || 'docx';\n\nreturn [{\n  json: {\n    ...precalc,\n    storage_path: storagePath,\n    path_within_bucket: pathWithinBucket,\n    file_name: fileName,\n    file_extension: ext,\n    is_pdf: ext === 'pdf',\n    is_docx: ext === 'docx' || ext === 'doc',\n    download_url: `https://hvlsuwdqtffiilvampxq.supabase.co/storage/v1/object/contracts/${pathWithinBucket}`\n  }\n}];"
            },
