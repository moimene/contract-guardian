                        },
                        {
                            "fieldName": "actor_id",
                            "fieldValue": "ContractReview"
                        }
                    ]
                }
            },
            "id": "audit_complete",
            "name": "Audit Complete",
            "type": "n8n-nodes-base.supabase",
            "typeVersion": 1,
            "position": [
                3050,
                300
            ],
            "credentials": {
                "supabaseApi": {
                    "id": "",
                    "name": "Supabase"
                }
            }
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{ { success: true, run_id: $json.run_id, document_id: $json.document_id, contract_decision: $json.contractDecision.contract_decision, changeset_id: $json.changeset?.changeset_id, total_clauses: $json.total_clauses } }}",
                "options": {}
            },
            "id": "respond",
            "name": "Respond",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1.1,
            "position": [
                3250,
                300
            ]
        }
