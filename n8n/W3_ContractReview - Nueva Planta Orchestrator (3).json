    {
      "parameters": {
        "jsCode": "// Extract clauses from document\n// In production, this calls a clause extraction service\n// For testing, we use sample clauses\n\nconst document = $json;\nconst runData = $('Create Run ID').first().json;\nconst crypto = require('crypto');\n\n// Sample clauses for testing Nueva Planta\n// In production, replace with actual document parsing\nconst sampleClauses = [\n  {\n    clause_id: 'clause_precio_1',\n    heading: 'Precio del Contrato',\n    clause_text: 'El precio total del contrato es de 15.000.000 EUR. El pago se realizara en 3 plazos: 30% a la firma, 40% al 50% de avance, y 30% a la recepcion definitiva. Se aplicara una retencion del 10% como garantia de buena ejecucion.'\n  },\n  {\n    clause_id: 'clause_alcance_1', \n    heading: 'Alcance de los Trabajos',\n    clause_text: 'El Contratista ejecutara todos los trabajos necesarios para la completa construccion de la planta, incluyendo cualquier trabajo adicional que sea requerido por el Propietario sin incremento de precio.'\n  },\n  {\n    clause_id: 'clause_resp_1',\n    heading: 'Responsabilidades del Contratista',\n    clause_text: 'El Contratista sera responsable de todos los danos que se produzcan durante la ejecucion de las obras, sin limitacion alguna, incluyendo danos indirectos y lucro cesante.'\n  },\n  {\n    clause_id: 'clause_hitos_1',\n    heading: 'Hitos y Entregables',\n    clause_text: 'Los hitos principales son: Hito 1 - Cimentacion (mes 6), Hito 2 - Estructura (mes 12), Hito 3 - Instalaciones (mes 18), Hito 4 - Puesta en marcha (mes 24). El retraso en cualquier hito conllevara penalizaciones del 1% semanal sin limite.'\n  },\n  {\n    clause_id: 'clause_term_1',\n    heading: 'Terminacion del Contrato',\n    clause_text: 'El Propietario podra resolver el contrato en cualquier momento y por cualquier causa, sin derecho a indemnizacion para el Contratista. En caso de terminacion, el Contratista debera abandonar la obra en un plazo de 48 horas.'\n  }\n];\n\n// Map clauses with run context\nconst clauses = sampleClauses.map((c, idx) => ({\n  clause_id: c.clause_id,\n  clause_instance_id: `${runData.document_id}_${c.clause_id}`,\n  sequence_number: idx + 1,\n  heading: c.heading,\n  clause_text: c.clause_text,\n  run_id: runData.run_id,\n  document_id: runData.document_id\n}));\n\nreturn clauses.map(c => ({ json: c }));"
      },
