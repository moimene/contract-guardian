        "jsCode": "// Create escalation requests for clauses that need human review\nconst data = $('Aggregate Decision').first().json;\nconst escalations = data.escalations || [];\n\nreturn escalations.map(esc => ({\n  json: {\n    run_id: data.run_id,\n    clause_instance_id: `${data.document_id}_${esc.clause_id}`,\n    status: 'pending',\n    message: esc.reason,\n    urgency: 'medium',\n    document_id: data.document_id\n  }\n}));"
