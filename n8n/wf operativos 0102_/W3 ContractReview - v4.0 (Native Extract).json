            "type": "n8n-nodes-base.xml",
            "typeVersion": 1
        },
        {
            "parameters": {
                "jsCode": "// Parse DOCX XML structure to extract text\nconst json = $json;\nlet allText = [];\n\nfunction extractText(obj) {\n  if (typeof obj === 'string') {\n    return obj.trim();\n  }\n  if (Array.isArray(obj)) {\n    return obj.map(extractText).filter(t => t).join(' ');\n  }\n  if (typeof obj === 'object' && obj !== null) {\n    // Look for 'w:t' elements which contain the actual text in DOCX\n    if (obj['w:t']) {\n      const textContent = obj['w:t'];\n      if (typeof textContent === 'string') {\n        return textContent;\n      } else if (Array.isArray(textContent)) {\n        return textContent.map(t => typeof t === 'string' ? t : (t._ || t['#text'] || '')).join('');\n      } else if (typeof textContent === 'object') {\n        return textContent._ || textContent['#text'] || '';\n      }\n    }\n    // Recursively process all properties\n    return Object.values(obj).map(extractText).filter(t => t).join(' ');\n  }\n  return '';\n}\n\n// Try to find 'w:document' > 'w:body' > 'w:p' (paragraphs)\ntry {\n  const body = json['w:document']?.['w:body'] || json['document']?.['body'] || json;\n  const text = extractText(body);\n  \n  if (!text || text.length < 50) {\n    // Fallback: search entire JSON\n    allText.push(extractText(json));\n  } else {\n    allText.push(text);\n  }\n} catch (e) {\n  allText.push(extractText(json));\n}\n\nconst finalText = allText.join('\\n\\n').replace(/\\s+/g, ' ').trim();\nconst precalc = $('Pre-calc Params').first().json;\n\nreturn [{\n  json: {\n    ...precalc,\n    extracted_text: finalText,\n    text_length: finalText.length,\n    extraction_method: 'docx_native'\n  }\n}];"
            },
