      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst input = $('Webhook Upload').first().json;\n\n// Extract file info from body\nlet file_name = 'contract.docx';\nlet contract_type = 'nueva_planta';\n\nif (input.body) {\n  file_name = input.body.file_name || input.body.fileName || 'contract.docx';\n  contract_type = input.body.contract_type || 'nueva_planta';\n}\n\n// Determine mime_type from extension\nlet mime_type = 'application/vnd.openxmlformats-officedocument.wordprocessingml.document';\nif (file_name.toLowerCase().endsWith('.pdf')) {\n  mime_type = 'application/pdf';\n}\n\nconst document_id = crypto.randomUUID();\nconst storage_path = `contracts/${document_id}/${file_name}`;\n\nreturn [{\n  json: {\n    document_id,\n    file_name,\n    mime_type,\n    storage_path,\n    contract_type,\n    playbook_id: 'nueva_planta',\n    playbook_version: '2026-01',\n    tenant_id: '00000000-0000-0000-0000-000000000001'\n  }\n}];"
      },
      "id": "313ac268-6a9e-4d68-8a77-19366d51b468",
