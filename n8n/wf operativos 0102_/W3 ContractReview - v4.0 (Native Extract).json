            "parameters": {
                "jsCode": "// Merge PDF extracted text with precalc data\nconst precalc = $('Pre-calc Params').first().json;\nconst text = $json.text || $json.data || '';\n\nreturn [{\n  json: {\n    ...precalc,\n    extracted_text: text,\n    text_length: text.length,\n    extraction_method: 'pdf_native'\n  }\n}];"
