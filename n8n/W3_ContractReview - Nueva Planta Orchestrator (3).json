    {
      "parameters": {
        "jsCode": "// Aggregate contract-level decision based on clause results\nconst results = $json.results || [];\nconst runData = $('Create Run ID').first().json;\n\nlet hasBlock = false;\nlet hasRequired = false;\nlet hasRecommended = false;\nlet escalations = [];\nlet blockReasons = [];\n\n// Count by client_state\nconst stateCounts = {\n  OK: 0,\n  RECOMMENDED: 0,\n  REQUIRED: 0,\n  NEEDS_REVIEW: 0,\n  BLOCKED: 0\n};\n\nfor (const r of results) {\n  const state = r.client_state || 'NEEDS_REVIEW';\n  stateCounts[state] = (stateCounts[state] || 0) + 1;\n  \n  if (state === 'BLOCKED') {\n    hasBlock = true;\n    blockReasons.push(r.escalation_reason || r.clause_id || 'Unknown');\n  }\n  if (state === 'REQUIRED') {\n    hasRequired = true;\n    escalations.push({\n      clause_id: r.clause_id,\n      reason: r.escalation_reason || 'Requires human review'\n    });\n  }\n  if (state === 'RECOMMENDED') {\n    hasRecommended = true;\n  }\n}\n\n// Determine contract-level decision\nlet contract_decision = 'READY_FOR_EXPORT';\nlet contract_status = 'completed';\n\nif (hasBlock) {\n  contract_decision = 'BLOCKED';\n  contract_status = 'blocked';\n} else if (hasRequired) {\n  contract_decision = 'NEEDS_REVIEW';\n  contract_status = 'review_pending';\n} else if (hasRecommended) {\n  contract_decision = 'READY_FOR_EXPORT'; // Can export but with recommendations\n  contract_status = 'completed';\n}\n\nreturn [{\n  json: {\n    results,\n    run_id: runData.run_id,\n    document_id: runData.document_id,\n    config: runData.config,\n    contractDecision: {\n      contract_decision,\n      contract_status,\n      escalations_pending: escalations.length,\n      block_reasons: blockReasons,\n      state_counts: stateCounts\n    },\n    escalations,\n    total_clauses: results.length\n  }\n}];"
      },
