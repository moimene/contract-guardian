        {
            "parameters": {
                "jsCode": "// v3.2 FIX: Robust parsing with extensive logging\nconst prevJson = $('Pre-calc Params').first().json;\nconst aiResponse = $json;\n\nconst uuid = () => 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {\n  const r = Math.random() * 16 | 0;\n  return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);\n});\n\nconst isUuid = (s) => typeof s === 'string' && /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(s);\n\nif (!isUuid(prevJson.document_id)) throw new Error(`Invalid document_id UUID: ${prevJson.document_id}`);\nif (!isUuid(prevJson.run_id)) throw new Error(`Invalid run_id UUID: ${prevJson.run_id}`);\n\nlet clauses = [];\ntry {\n  const content = aiResponse.choices?.[0]?.message?.content || '';\n  console.log(`[Format & Split] OpenAI response (first 500 chars): ${content.substring(0, 500)}`);\n  \n  if (!content) throw new Error('OpenAI returned empty content');\n  \n  const parsed = JSON.parse(content);\n  console.log(`[Format & Split] Parsed keys: ${Object.keys(parsed).join(', ')}`);\n  \n  clauses = parsed.clauses || parsed.items || parsed.sections || parsed.data || parsed.results || (Array.isArray(parsed) ? parsed : []);\n  \n  if (clauses.length === 0) {\n    for (const key of Object.keys(parsed)) {\n      if (Array.isArray(parsed[key]) && parsed[key].length > 0) {\n        console.log(`[Format & Split] Found array in key: ${key}`);\n        clauses = parsed[key];\n        break;\n      }\n    }\n  }\n  console.log(`[Format & Split] Found ${clauses.length} clauses`);\n} catch (e) {\n  console.error(`[Format & Split] Parse error: ${e.message}`);\n  console.error(`[Format & Split] Raw response: ${JSON.stringify(aiResponse).substring(0, 1000)}`);\n  throw new Error(`AI Parse failed: ${e.message}`);\n}\n\nif (clauses.length === 0) {\n  const rawContent = aiResponse.choices?.[0]?.message?.content || 'NO CONTENT';\n  throw new Error(`AI Parse returned 0 clauses. Raw: ${rawContent.substring(0, 500)}`);\n}\n\nreturn clauses.map((c, i) => ({\n  json: {\n    ...prevJson,\n    clause_instance_id: uuid(),\n    clause_id: c.clause_id || c.id || `clause_${i+1}`,\n    clause_text: c.clause_text || c.text || c.content || '',\n    heading: c.heading || c.title || c.section || '',\n    total_clauses: clauses.length,\n    clause_index: i\n  }\n}));"
            },
