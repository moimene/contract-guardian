        {
            "parameters": {
                "jsCode": "// Filter to get only document.xml from the unzipped DOCX\nconst items = $input.all();\nlet documentXml = null;\n\nfor (const item of items) {\n  const fileName = item.binary?.data?.fileName || '';\n  if (fileName.includes('word/document.xml') || fileName === 'document.xml') {\n    documentXml = item;\n    break;\n  }\n}\n\nif (!documentXml) {\n  // Try to find any XML that might contain the text\n  for (const item of items) {\n    const fileName = item.binary?.data?.fileName || '';\n    if (fileName.endsWith('.xml') && fileName.includes('word')) {\n      documentXml = item;\n      break;\n    }\n  }\n}\n\nif (!documentXml) {\n  throw new Error('Could not find document.xml in DOCX archive');\n}\n\nreturn [documentXml];"
            },
            "id": "filter_document_xml",
            "name": "Filter document.xml",
            "position": [
                1640,
                404
            ],
            "type": "n8n-nodes-base.code",
            "typeVersion": 2
